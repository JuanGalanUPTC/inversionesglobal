<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="800.0" prefHeight="600.0" spacing="20.0" styleClass="root-container" stylesheets="@../css/misInversiones.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.MisInversionesController">
    
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
    </padding>

    <VBox spacing="5.0">
        <Label styleClass="header-title" text="¡Hola Inversionista!" />
        <Label styleClass="header-subtitle" text="Bienvenido al Menú Principal. ¿En qué vamos a invertir hoy?" />
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </VBox>

    <VBox styleClass="card" spacing="5.0">
        <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
        </padding>
        <Label styleClass="card-label-small" text="TU SALDO DISPONIBLE" />
        <Label styleClass="card-balance" text="\$20,000" />
    </VBox>

    <VBox alignment="CENTER" styleClass="card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
        </padding>
        
        <StackPane styleClass="icon-container">
            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/lupa_icon.png" /> 
                </image>
            </ImageView>
        </StackPane>
        
        <Label styleClass="empty-state-title" text="Realiza tu primera inversión" />
        <Label styleClass="empty-state-subtitle" text="No tienes ninguna inversión activa actualmente." />
    </VBox>

    <HBox alignment="CENTER">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
        <Button mnemonicParsing="false" styleClass="btn-primary-dark" text="Nueva Inversión" />
    </HBox>

</VBox>