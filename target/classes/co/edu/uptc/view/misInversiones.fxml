<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.MisInversionesController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <Label text="¡Hola Inversionista!" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Bienvenido al Menú Principal. ¿En qué vamos a invertir hoy?" style="-fx-text-fill: gray;"/>
    
    <VBox style="-fx-background-color: white; -fx-background-radius: 10;">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        <Label text="TU SALDO DISPONIBLE" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
        
        <Label fx:id="saldoLabel" text="\$0.00" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
    </VBox>
</VBox>