<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="root-container" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.RestorePasswordController">
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <VBox alignment="TOP_LEFT" maxWidth="320.0" prefWidth="300.0" spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                  <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#backToLogin" prefHeight="57.0" prefWidth="162.0" styleClass="exit-button" stylesheets="@../css/login.css" text="Volver">
                     <graphic>
                        <ImageView fitHeight="51.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/flechaIcon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                        <ComboBox id="idiomaComboBox" fx:id="idiomaComboBox" maxHeight="100.0" maxWidth="255.0" prefHeight="100.0" prefWidth="255.0" promptText="Cambiar idioma" styleClass="combo-idioma" visibleRowCount="2">
                            <VBox.margin>
                                <Insets top="550.0" />
                            </VBox.margin>
                        </ComboBox>
                    </children>
                    <padding>
                        <Insets left="30.0" top="40.0" />
                    </padding>
                </VBox>
                <VBox alignment="CENTER" maxWidth="480.0" minWidth="450.0" prefWidth="460.0" spacing="20.0" HBox.hgrow="NEVER">
                    <children>
                        <ImageView fitHeight="175.0" fitWidth="444.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/idonfilingenimore.png" />
                            </image>
                        </ImageView>
                  <VBox prefHeight="200.0" prefWidth="100.0" styleClass="success-box" stylesheets="@../css/login.css">
                     <children>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/successIcon.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="success-message" text="Tu cuenta de GLOBAL ha sido creada correctamente." wrapText="true" />
                        <Button mnemonicParsing="false" onAction="#backToLogin" styleClass="btn-success-action" text="IR A INICIO DE SESIÓN" />
                     </children></VBox>
                    </children>
                </VBox>
                <VBox alignment="CENTER_RIGHT" maxWidth="320.0" prefWidth="300.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="warningBox" alignment="CENTER" managed="false" spacing="20.0" styleClass="warning-box" visible="false">
                            <children>
                                <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/warningIcon.png" />
                                    </image>
                                </ImageView>
                                <Label fx:id="warningMessage" styleClass="warning-message" text="Por favor, contesta los campos para continuar." />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets right="30.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
