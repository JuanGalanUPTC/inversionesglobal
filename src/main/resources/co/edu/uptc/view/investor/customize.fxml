<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-container" stylesheets="@../../css/misInversiones.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.investor.CustomizeController">
    <content>
        <VBox spacing="20.0" styleClass="root-container">
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
            </padding>

            <VBox spacing="5.0">
                <Label styleClass="header-title" text="Personaliza tu cuenta" />
                <Label styleClass="header-subtitle" text="Ponte una bonita foto de perfil, cambia tu nombre de usuario o tu perfil de riesgo!" />
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </VBox>

            <VBox alignment="CENTER" styleClass="card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
                </padding>
                
                <Label styleClass="empty-state-title" text="MI FOTO DE PERFIL" />
            <ImageView fitHeight="146.0" fitWidth="187.0" pickOnBounds="true" preserveRatio="true" />
            <Button mnemonicParsing="false" styleClass="btn-primary-dark" text="Cargar foto de perifl">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            </VBox>

            <HBox alignment="CENTER">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </HBox>
         <VBox alignment="CENTER" styleClass="card">
            <padding>
               <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
            </padding>
            <children>
               <Label styleClass="empty-state-title" text="MI NOMBRE DE USUARIO ES:" />
               <Label styleClass="card-label-small" text="Label" />
               <Button mnemonicParsing="false" styleClass="btn-primary-dark" text="Cambiar Nombre de Usuario">
                  <VBox.margin>
                     <Insets top="10.0" />
                  </VBox.margin>
               </Button>
            </children>
         </VBox>
        </VBox>
    </content>
</ScrollPane>
