<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" prefHeight="600.0" prefWidth="900.0" styleClass="dashboard-container" stylesheets="@../../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.investor.DashboardController">
            
    <left>
        <VBox fx:id="sidebar" prefWidth="255.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>
         <HBox prefHeight="110.0" prefWidth="251.0" stylesheets="@../../css/misInversiones.css">
            <children>
               <ImageView fx:id="avatarImageView" fitHeight="74.0" fitWidth="77.0" pickOnBounds="true" preserveRatio="true" styleClass="profileImage">
                  <image>
                     <Image url="@../../images/userIconDefault.jpg" />
                  </image>
                  <HBox.margin>
                     <Insets top="20.0" />
                  </HBox.margin>
               </ImageView>
               <VBox prefHeight="84.0" prefWidth="119.0">
                  <children>
                     <Button mnemonicParsing="false" prefHeight="24.0" prefWidth="28.0" styleClass="btn-customize">
                        <graphic>
                           <ImageView fitHeight="14.0" fitWidth="17.0" pickOnBounds="true" preserveRatio="true" styleClass="profileImage">
                              <image>
                                 <Image url="@../../images/customizeIcon.png" />
                              </image>
                           </ImageView>
                        </graphic>
                        <VBox.margin>
                           <Insets left="100.0" />
                        </VBox.margin>
                     </Button>
                     <Label fx:id="nombreLabel" prefHeight="40.0" prefWidth="131.0" styleClass="header-title" text="Nombre" wrapText="true" />
                     <Label fx:id="rolLabel" prefHeight="26.0" prefWidth="181.0" styleClass="header-subtitle" text="Rol" />
                  </children>
                  <HBox.margin>
                     <Insets left="10.0" />
                  </HBox.margin>
               </VBox>
            </children>
         </HBox>
            
            <Button maxWidth="Infinity" onAction="#mostrarMisInversiones" styleClass="menu-button" text="Mis Inversiones" />
            <Button maxWidth="Infinity" onAction="#mostrarReportes" styleClass="menu-button" text="Reportes" />
            <Button maxWidth="Infinity" onAction="#mostrarActivos" styleClass="menu-button" text="Activos" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox alignment="BOTTOM_CENTER" spacing="15.0">
                <Button fx:id="btnCerrarSesion" maxWidth="Infinity" onAction="#handleCerrarSesion" styleClass="btn-logout" text="Cerrar Sesión" />
                
                <ComboBox id="idiomaComboBox" fx:id="idiomaComboBox" maxWidth="Infinity" prefHeight="40.0" promptText="Cambiar idioma" styleClass="combo-idioma" visibleRowCount="2">
                </ComboBox>
            </VBox>
        </VBox>
    </left>
    
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <ImageView fitWidth="400.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/co/edu/uptc/images/logotipo.png" />
                </image>
            </ImageView>
        </StackPane>
    </center>
</BorderPane>
